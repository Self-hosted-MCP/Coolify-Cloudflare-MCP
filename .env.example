# Names only. Real values go into Coolify (Environment Variables, Is Literal on for every secret). Never into a file or a note.
PUBLIC_URL=https://ops.example.com            # Claude's door (placeholder name)
CONFIRM_URL=https://confirm.example.com       # the owner's Confirm page, behind Zero Trust
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com
LOGIN_HASH=                                   # secret. Made with: coolify-cloudflare-mcp hash
SECRET_KEY=                                   # secret. A long random string
ACCESS_ENFORCE=1                              # Zero Trust on the Confirm page. Stays ON unless this is exactly 0, false, no or off (only for a test on your computer).
CF_ACCESS_TEAM_DOMAIN=                        # like yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                                # the Zero Trust app's Audience tag for the Confirm page
CONFIRM_ALLOWED_EMAILS=                       # the owner's email, the only identity the Confirm page accepts
COOLIFY_API_URL=http://host.docker.internal:8000   # no /api/v1. Check in docs/deploy.md
COOLIFY_TOKEN=                                # secret. Start with a READ-ONLY token (read), add deploy only when needed
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_READ_TOKEN=                        # secret. Read-only template, limited to the account and the zone
CLOUDFLARE_ZONE_NAME=                         # like example.com. Every Cloudflare change must stay inside it
CLOUDFLARE_EDIT_TOKEN=                        # secret. ONLY for DNS records and the tunnel's routes, ONLY this zone and account. Leave empty to switch changes off
CLOUDFLARE_TUNNEL_ID=                         # the one tunnel whose routes can be changed
PROTECTED_HOSTNAMES=                          # comma list of hosts that need a typed word (this server's own doors, Coolify, SSH and the zone are always protected)
ROUTE_BLOCKED_PORTS=                          # extra ports a route may never point at (SSH, Docker 2375/2376, Coolify 8000/6001/6002 and these two doors are always blocked; 8080 too unless allowed below)
ROUTE_ALLOWED_PORTS=                          # strict mode (recommended once set up): when filled, a route may ONLY point at these ports, still never at the always-blocked ones
SSH_HOST=                                     # the terminal: the server's address (leave all SSH_ lines empty to switch the terminal off)
SSH_PORT=22
SSH_USER=                                     # its own user, never root and never the owner's own
SSH_PRIVATE_KEY=                              # secret. This user's own key. New lines written as \n
SSH_KNOWN_HOSTS=                              # the server's public key line: "host ssh-ed25519 AAAA..." (for a port other than 22: "[host]:port ssh-ed25519 AAAA...")
READ_ONLY=0                                   # anything that is not plainly 0, false, no or off = no change can even be asked for
# Optional: UNFREEZE_MINUTES=60 HTTP_TIMEOUT_SECONDS=20 ACTION_LOG_MAX_MB=2 CONFIRM_WAIT_SECONDS=45 CONFIRM_TTL_SECONDS=300 OUTPUT_MAX_CHARS=8000 MAX_LOG_LINES=200 RATE_LIMIT_PER_MINUTE=30 ALLOW_ALL_MINUTES=10 (0 = no Allow all button)
